# Copy this file to .env and adjust as needed

PORT=5000

# Used to sign/verify JWTs - replace with a long random string in real use
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=7d

# Comma-separated list of origins allowed to call this API
CLIENT_ORIGIN=http://localhost:5173

# NOTE: MongoDB connection string arrives in Session/Milestone M3
# (Persistence & Offline Support), when Task/User models move from
# in-memory arrays to Mongoose schemas.
# MONGODB_URI=mongodb://localhost:27017/syncboard
