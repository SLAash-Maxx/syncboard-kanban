# Copy this file to .env and adjust as needed

PORT=5000

# Used to sign/verify JWTs - replace with a long random string in real use
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=7d

# Comma-separated list of origins allowed to call this API
CLIENT_ORIGIN=http://localhost:5173

# MongoDB connection string (Milestone 3 - Persistence & Offline Support).
# Local MongoDB:
# MONGODB_URI=mongodb://localhost:27017/syncboard
# MongoDB Atlas (replace <user>/<password>/<cluster> with your own):
MONGODB_URI=mongodb://<user>:<password>@<cluster>.mongodb.net:27017/?ssl=true&replicaSet=<replicaset>&authSource=admin
